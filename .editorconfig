root = true

# The repo stores LF and core.autocrlf=true hands out CRLF on this machine, so the working copy is CRLF.
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cmd,bat,ps1}]
end_of_line = crlf
trim_trailing_whitespace = false

# setup.ps1 carries Russian strings and must keep its BOM: Windows PowerShell 5.1 reads a BOM-less script as ANSI.
[*.ps1]
charset = utf-8-bom

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,jsonl,yml,yaml}]
indent_size = 2

[*.tsv]
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = false
